# Copy to .env and fill in.
# Get a free TMDB API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
REFRESH_INTERVAL_MINUTES=60
DB_PATH=demand_intel.db

# Optional: collect per-region Trends (comma-separated). Default = GLOBAL only. Extra regions increase API calls -> 429 risk.
# Example: GOOGLE_TRENDS_GEOS=GLOBAL,US,GB
GOOGLE_TRENDS_GEOS=GLOBAL
GEMINI_API_KEY=
OPENCODE_API_KEY=
